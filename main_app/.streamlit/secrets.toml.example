# Copy this file to  .streamlit/secrets.toml  (never commit the real one).
# On Streamlit Community Cloud, paste these lines into  App settings → Secrets.

# Required for the Claude chatbot (the app shows an offline answer without it)
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: live material data. Share the sheet as "Anyone with the link: Viewer".
# Headers: Material, Overall_Score, Carbon_Score, Recyclability_Score, Resource_Efficiency
# GOOGLE_SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=0"
